# =============================================================================
#  EXCELLENCE REFORMAS · variables de entorno del servidor
#  Copia este archivo como `.env.local` (desarrollo) o configúralas en tu
#  plataforma de hosting. NUNCA subas un .env con valores reales al repositorio.
#  Los datos públicos (teléfono, WhatsApp, Instagram…) van en src/config/site.ts.
# =============================================================================

# --- Email: aviso de cada nueva solicitud ------------------------------------
# Email empresarial que recibe las solicitudes (varios separados por comas).
NOTIFY_EMAIL_TO=
# Remitente. Debe ser una dirección autorizada por tu proveedor SMTP.
MAIL_FROM="Web Excellence Reformas <web@tudominio.es>"
# Servidor SMTP (Google Workspace, Microsoft 365, IONOS, Resend, Brevo…)
SMTP_HOST=
SMTP_PORT=587
# true para el puerto 465 (SSL directo); false para 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# En producción, la solicitud solo se confirma al cliente cuando el email sale.
# (por defecto: true en producción, false en desarrollo)
# REQUIRE_EMAIL_NOTIFICATION=true

# --- Almacenamiento privado de solicitudes y fotos ---------------------------
# local → carpeta del servidor (DATA_DIR). Solo para desarrollo o un servidor
#         propio con disco persistente. NO sirve en Vercel.
# s3    → bucket privado compatible con S3 (Cloudflare R2, AWS S3, Backblaze B2…)
STORAGE_DRIVER=local
DATA_DIR=.data

# S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=excellence-solicitudes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=web
# S3_FORCE_PATH_STYLE=true

# --- Seguridad ----------------------------------------------------------------
# Orígenes adicionales autorizados a enviar el formulario (el dominio de
# src/config/site.ts y los de Vercel se añaden solos).
# ALLOWED_ORIGINS=https://www.excellencereformas.es
# Envíos máximos por IP y ventana (minutos).
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MINUTES=10
